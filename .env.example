# Placeholder configuration contract (docs/04-delivery-and-operations.md §3).
# Copy to .env (local) or set in Vercel. Never commit real values.

# --- Browser-visible (Supabase session + RLS) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Stable production origin used by runner callbacks, relay and cron ---
APP_BASE_URL=http://localhost:3000

# --- Server only ---
SUPABASE_SECRET_KEY=

# Nebius Token Factory (OpenAI-compatible)
TOKEN_FACTORY_API_KEY=
TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEMOTRON_MODEL_ID=nvidia/Nemotron-3_5-Lightning
# Preferred: NVIDIA Nemotron Nano 12B v2 VL once `pnpm probe:models` confirms its id and serverless access.
VISION_MODEL_ID=openbmb/MiniCPM-V-4_5

# Cloudflare R2 (private bucket)
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# GitHub dispatch (GitHub App preferred; fine-grained PAT allowed during pilot)
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_DISPATCH_TOKEN=
GITHUB_REPOSITORY=owner/repo
GITHUB_WORKFLOW_ID=qa-run.yml
GITHUB_WORKFLOW_REF=main

# Runner identity
RUNNER_TOKEN_SIGNING_KEY=
RUNNER_OIDC_AUDIENCE=autonomous-mobile-qa

# Maintenance endpoint (also stored in Supabase Vault)
CRON_AUTH_SECRET=

# Encryption for credentials of the app under test (V1: P2)
APP_CREDENTIALS_ENCRYPTION_KEY=
