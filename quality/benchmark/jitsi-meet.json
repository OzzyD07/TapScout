    {
      "id": "prejoin",
      "name": "Pre-join",
      "any": ["Join meeting"]
    },
    {
      "id": "conference",
      "name": "In the meeting",
      "any": [
        "~only one in the meeting",
        "~Leave the meeting",
        "~Hang up",
        "~waiting for",
        "~Log-in"
      ]
    }
  ],
