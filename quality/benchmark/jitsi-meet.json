    {
      "id": "recent",
      "name": "Recent meetings",
      "any": ["~Your recent list is currently empty"]
    },
    {
      "id": "settings",
      "name": "Settings",
      "all": ["Hide self view"],
      "any": ["Language", "Conference", "Taal", "Konferensie"],
      "markerNote": "v26 shows Settings as a tab without 'Display name'/'Server URL' labels (run f86858fd); markers corrected to the tab's own rows."
