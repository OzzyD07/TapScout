{
  "key": "antennapod",
  "app": "AntennaPod",
  "stack": "Java/Kotlin, Android Views",
  "source": "https://github.com/AntennaPod/AntennaPod (F-Droid 3.12.2)",
  "license": "GPL-3.0-only",
  "platforms": ["android"],
  "android": {
    "package": "de.danoeh.antennapod"
  },
  "access": "open",
  "traits": [
    "list/backend (podcast search, feeds)",
    "notification permission (Android 13+)",
    "bottom navigation"
  ],
  "screensSource": "Navigation items and empty states in ui/i18n/src/main/res/values/strings.xml at 3.12.2. A fresh install has no subscriptions, so lists show their empty state.",
  "screens": [
    {
      "id": "home",
      "name": "Home",
      "any": ["Welcome to AntennaPod!", "Continue listening", "Get surprised"]
    },
    {
      "id": "queue",
      "name": "Queue",
      "any": ["No queued episodes", "~No episodes lined up"]
    },
    {
      "id": "inbox",
      "name": "Inbox",
      "any": ["No episodes in the inbox"]
    },
    {
      "id": "subscriptions",
      "name": "Subscriptions",
      "any": ["No subscriptions", "~To subscribe to a podcast"]
    },
    {
      "id": "add_podcast",
      "name": "Add podcast",
      "any": ["Search Apple Podcasts", "Add podcast by RSS address", "OPML import"]
    },
    {
      "id": "podcast_preview",
      "name": "Podcast preview (from search)",
      "all": ["Subscribe"]
    },
    {
      "id": "episodes",
      "name": "Episodes",
      "any": ["~When you add a podcast, the episodes will be shown here"]
    },
    {
      "id": "downloads",
      "name": "Downloads",
      "any": ["No downloaded episodes", "No download log"]
    },
    {
      "id": "history",
      "name": "Playback history",
      "any": ["No history"]
    },
    {
      "id": "settings",
      "name": "Settings",
      "all": ["User interface", "Backup & restore"]
    }
  ],
  "knownIssues": [],
  "verdicts": [
    {
      "check": "a11y.control_labels",
      "region": {
        "x": 84,
        "y": 472
      },
      "verdict": "true_positive",
      "reason": "Podcast cover (imgvCover) clickable without a content description.",
      "firstSeen": "47fcde0b"
    },
    {
      "check": "a11y.touch_targets",
      "titleIncludes": "https://",
      "verdict": "true_positive",
      "reason": "Standalone feed URL label, 28dp tall.",
      "firstSeen": "47fcde0b"
    },
    {
      "check": "a11y.touch_targets",
      "titleIncludes": "Oct 2026",
      "verdict": "true_positive",
      "reason": "Date spinners of the statistics filter, 24dp tall.",
      "firstSeen": "47fcde0b"
    },
    {
      "check": "a11y.touch_targets",
      "titleIncludes": "Elisabeth Vincentelli",
      "verdict": "false_positive",
      "reason": "Inline link inside the episode's web show notes (WCAG 2.5.8 inline exception).",
      "firstSeen": "47fcde0b"
    },
    {
      "check": "a11y.control_labels",
      "region": {
        "width": 249,
        "height": 249
      },
      "verdict": "true_positive",
      "reason": "Discovery tiles are a cover ImageView without a content description; TalkBack has nothing to announce.",
      "firstSeen": "e24b2ce6"
    },
    {
      "check": "a11y.control_labels",
      "verdict": "false_positive",
      "reason": "Clickable menu rows, search results and More-sheet rows announced by their child texts; a non-clickable checkbox inside a labelled row; the bottom-sheet scrim (touch_outside).",
      "firstSeen": "e24b2ce6"
    },
    {
      "check": "ui.keyboard_occlusion",
      "verdict": "false_positive",
      "reason": "Bottom navigation hidden behind the keyboard on the search screen, by Android design.",
      "firstSeen": "e24b2ce6"
    }
  ],
  "notes": "Lists filled after subscribing lose their empty-state marker; such a session can under-count Queue/Inbox/Episodes."
}
