    { "id": "search", "name": "Search / communities", "any": ["Search…"] },
    { "id": "community", "name": "Community page", "any": ["~users / month"] },
    { "id": "login", "name": "Login", "all": ["Instance", "Password"] },
    { "id": "settings", "name": "Settings", "all": ["Look and feel"] },
    { "id": "about", "name": "About", "any": ["~source code", "~Donate", "~Matrix"] }
  ],
